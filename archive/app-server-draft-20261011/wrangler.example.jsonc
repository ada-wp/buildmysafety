{
  "name": "buildmysafety-app-v0",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-11",
  "assets": {"directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "choose-during-preview-setup", "database_id": "REPLACE_BEFORE_DEPLOYMENT"}]
}
