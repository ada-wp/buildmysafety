{
  "type": "json_schema",
  "name": "safety_three_ideas_search_candidate",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "decision",
      "tasks"
    ],
    "properties": {
      "decision": {
        "type": "string",
        "enum": [
          "generated",
          "no_new_idea",
          "needs_context",
          "out_of_scope",
          "safety_redirect"
        ]
      },
      "tasks": {
        "type": "array",
        "minItems": 0,
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "action_key": {
              "type": "string"
            },
            "concern_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "food",
                  "getting_care",
                  "daily_tasks",
                  "check_in",
                  "pets"
                ]
              }
            },
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "estimated_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            },
            "done_when": {
              "type": "string"
            },
            "resources": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "resource_id": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                },
                "required": [
                  "resource_id",
                  "why"
                ],
                "additionalProperties": false
              }
            },
            "purchase_checks": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "string"
              }
            },
            "no_purchase_option": {
              "type": [
                "string",
                "null"
              ]
            },
            "search_prompt": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "action_key",
            "concern_ids",
            "title",
            "summary",
            "estimated_minutes",
            "steps",
            "done_when",
            "resources",
            "purchase_checks",
            "no_purchase_option",
            "search_prompt"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
